{
  "name": "kcm-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "KCM 워크스페이스 · 홈 헤더·사용자 프로필·고정 사이드바",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/check-env.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/domain.test.js .test-dist/tests/retell.test.js .test-dist/tests/liveCalls.test.js server/tests/*.test.mjs",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "npm run test && npm run build",
    "preview:standalone": "node scripts/generate-preview.mjs"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "retell-client-js-sdk": "3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
