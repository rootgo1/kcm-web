RETELL_API_KEY=
RETELL_AGENT_ID=agent_0cf2b1f09a8e52e6d2abc45b71
PORT=8787

# Server only. Fill these in locally / in Render Environment; never commit actual values.
N8N_WEBHOOK_URL=
KCM_DEMO_CUSTOMER_ID=
KCM_DEMO_STORE_ID=

# Server-only read access to existing public tables. No VITE_ key and no DB writes.
# Supply a key with only the required SELECT grants/RLS access; never commit it.
SUPABASE_URL=
SUPABASE_READ_KEY=

# Server-only staff login. Use the same Supabase project as the read provider.
# A publishable key is separate from the read key; never use a secret/service-role key here.
SUPABASE_AUTH_PUBLISHABLE_KEY=
# Explicit approved Auth user -> employee/home-store or customers:read store mapping, JSON array.
# Leave empty until the administrator has approved the accounts. Never use user_metadata.
STAFF_READ_ACCOUNTS_JSON=

# Render only: set NODE_ENV=production on the service; leave unset for local dev.
# RENDER_EXTERNAL_URL supplies the default HTTPS origin automatically.
# KCM_PUBLIC_ORIGIN=https://your-service.onrender.com
